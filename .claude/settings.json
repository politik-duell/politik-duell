{
  "permissions": {
    "deny": [
      "Read(./supabase/seed.sql)",
      "Read(./supabase/seed-teile/**)",
      "Read(./dist/**)"
    ]
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "WebFetch|WebSearch|Read|Write|Edit|MultiEdit|NotebookEdit|Grep|Glob|Bash|PowerShell|NotebookRead",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const p=require('path'),u=require('url');import(u.pathToFileURL(p.join(process.env.CLAUDE_PROJECT_DIR||process.cwd(),'.claude','hooks','sperre.mjs')).href).then(m=>m.hauptprogramm())\""
          }
        ]
      }
    ]
  }
}
