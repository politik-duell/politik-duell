{
  "permissions": {
    "deny": [
      "Read(./supabase/seed.sql)",
      "Read(./supabase/seed-teile/**)",
      "Read(./dist/**)"
    ]
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "WebFetch|WebSearch|Read|Write|Edit|MultiEdit|NotebookEdit|Grep|Glob|Bash|NotebookRead",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/sperre.mjs\""
          }
        ]
      }
    ]
  }
}
