    {
      "partei_id": 18,
      "land": "BE",
      "massnahmen": [
        {
          "beschreibung": "Mental Health Coaches an Schulen und Jugendzentren und Mental Health im Lehrplan verankern; Mental Health Days vor Ort einführen.",
          "ursachen_ids": [
            2903
          ],
          "zitat": "Wir führen „Mental Health Days“ auf lokaler Ebene ein und erheben regelmäßig Daten zur psychischen Gesundheit in Berlin. Wir etablieren Mental Health Coaches an Schulen und Jugendzentren und verankern Mental Health im Lehrplan.",
          "seite": 83
        },
        {
          "beschreibung": "Pflichtfach Lebenskompetenz mit Schwerpunkt psychische Gesundheit, Empathie und sozial-emotionalem Lernen, zunächst an Pilotschulen.",
          "ursachen_ids": [
            2903
          ],
          "zitat": "Wir führen „Lebenskompetenz“ als Pflichtfach ein. Damit stärken wir Kompetenzen für ein selbstbestimmtes Leben in den Bereichen Gesundheit und Prävention mit Fokus auf psychische Gesundheit",
          "seite": 48
        },
        {
          "beschreibung": "Gesundheitskioske und Gesundheitslots*innen für niedrigschwellige, mehrsprachige Beratung in benachteiligten Stadtteilen.",
          "ursachen_ids": [
            2903
          ],
          "zitat": "Wir führen Gesundheitskioske und Gesundheitslots*innen zur niedrigschwelligen, mehrsprachigen Beratung und Stärkung der Gesundheitskompetenz – und das über alle Lebensphasen hinweg – in besonders benachteiligten Stadtteilen ein.",
          "seite": 80
        },
        {
          "beschreibung": "Betroffene in Anti-Stigma-Kampagnen und Programme zur psychischen Gesundheit einbeziehen.",
          "ursachen_ids": [
            2904
          ],
          "zitat": "Wir beziehen Betroffene mit ein: bei der Gestaltung von Programmen, bei Anti-Stigma-Kampagnen und bei der Förderung von Gesundheitskompetenz in Schulen, Vereinen und Betrieben.",
          "seite": 83
        },
        {
          "beschreibung": "Begegnungsorte gegen Einsamkeit wie Mehrgenerationencafés und Nachbarschaftszentren schaffen.",
          "ursachen_ids": [
            2901
          ],
          "zitat": "Wir schaffen Begegnungsorte gegen Einsamkeit, wie Mehrgenerationencafés und Nachbarschaftszentren, von denen insbesondere Senior*innen, Kinder und Jugendliche profitieren.",
          "seite": 83
        }
      ]
    },
