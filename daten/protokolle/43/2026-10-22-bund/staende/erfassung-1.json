{
  "thema_id": 43,
  "programme": [
    {
      "partei_id": 11,
      "land": null,
      "massnahmen": [
        {
          "beschreibung": "Verwaltung mit KI effizient und vollständig digitalisiert aufbauen, auch für Bescheide bei eindeutigen Sachverhalten",
          "ursachen_ids": [],
          "ursachen_offen": [
            4301
          ],
          "buendel": "KI-Einsatz vorantreiben, neue KI-Berufe schaffen",
          "zitat": "Mit dem Einsatz von KI bauen wir in Deutschland eine effiziente, vollständig digitalisierte Verwaltung für Bürger und Unternehmen auf",
          "seite": 29
        },
        {
          "beschreibung": "EU-KI-Verordnung innovationsoffen umsetzen, keine Übererfüllung, KI-Forschung fördern und beschleunigen",
          "ursachen_ids": [],
          "ursachen_offen": [
            4303
          ],
          "buendel": "Gegenrichtung: Forschung und offene Modelle erlauben",
          "zitat": "Die Verordnung der EU („AI Act“) muss verantwortungsvoll, bürokratiearm und innovationsoffen umgesetzt und weiterentwickelt werden. Eine Übererfüllung lehnen wir strikt ab. Wir fördern und beschleunigen KI-Forschung, unterstützen die Entwicklung von Anwendungen und ermöglichen Freiräume.",
          "seite": 29
        },
        {
          "beschreibung": "Sicherheitsbehörden digitale Befugnisse geben, einschließlich automatischer Datenanalyse mittels KI",
          "ursachen_ids": [],
          "ursachen_offen": [
            4303
          ],
          "zitat": "Wir schaffen digitale Befugnisse wie Quellen-Telekommunikationsüberwachung, Online-Durchsuchung und automatische Datenanalyse mittels KI für alle Bundessicherheitsbehörden.",
          "seite": 40
        }
      ],
      "nicht_erfasst": [
        {
          "ursache": 4302,
          "seiten": [
            29,
            32,
            65,
            66,
            67
          ],
          "grund": "Weiterbildung, Berufsbildung und Arbeitsmarkt ohne KI-Bezug (S. 65, 67: Digitalisierung der Weiterbildung, Teil- und Weiterqualifizierung, Allianz); KI nur als Einsatz in Verwaltung und Ämtern (S. 29, 32), kein Zugang zu KI-Kompetenz."
        }
      ],
      "neue_buendel": [
        {
          "ursache": 4303,
          "name": "KI-Einsatz der Sicherheitsbehörden",
          "seite": 40
        }
      ],
      "eigene_synonyme": [
        {
          "begriff": "einsatz von ki",
          "ursache": 4301,
          "richtung": "KI-Einsatz vorantreiben, neue KI-Berufe schaffen"
        },
        {
          "begriff": "ki-forschung",
          "ursache": 4303,
          "richtung": "Gegenrichtung: Forschung und offene Modelle erlauben"
        }
      ]
    },
    {
      "partei_id": 12,
      "land": null,
      "massnahmen": [
        {
          "beschreibung": "Betriebsräte bei der Einführung von Künstlicher Intelligenz mit echtem Mitbestimmungsrecht ausstatten (Einigungserfordernis).",
          "ursachen_ids": [
            4301
          ],
          "zitat": "Wir reformieren das Betriebsverfassungsgesetz und werden die Mitbestimmung der Betriebsräte bei strategischer Personalplanung und -bemessung, bei der Einführung von Künstlicher Intelligenz sowie bei Gesundheitsschutz und Weiterbildung im Betrieb zu echten Mitbestimmungsrechten mit Einigungserfordernis ausbauen.",
          "seite": 13
        },
        {
          "beschreibung": "Verwaltungsprozesse mit Automatisierung und KI beschleunigen; dadurch sollen Beschäftigte entlastet werden.",
          "ursachen_ids": [],
          "ursachen_offen": [
            4301
          ],
          "zitat": "Wir nutzen Automatisierung und Künstliche Intelligenz, um Verwaltungsprozesse zu beschleunigen und effizienter zu gestalten. So entlasten wir die Beschäftigten und verbessern den Service für die Bürgerinnen und Bürger.",
          "seite": 38
        },
        {
          "beschreibung": "Bot-Kennzeichnungspflicht aus der KI-Verordnung strikt durchsetzen.",
          "ursachen_ids": [
            4303
          ],
          "zitat": "Wir wollen außerdem eine strikte Durchsetzung der Bot-Kennzeichnungspflicht aus der KI-Verordnung",
          "seite": 50
        },
        {
          "beschreibung": "Dafür sorgen, dass KI-generierte Inhalte klar erkennbar sind.",
          "ursachen_ids": [
            4303
          ],
          "zitat": "Zudem sorgen wir dafür, dass KI-generierte Inhalte klar erkennbar sind.",
          "seite": 51
        },
        {
          "beschreibung": "Europäische Plattform- und KI-Regeln durchsetzen und Plattformen zum Vorgehen gegen illegale Inhalte verpflichten.",
          "ursachen_ids": [],
          "ursachen_offen": [
            4303
          ],
          "zitat": "Es gilt die europäischen Regelungen (DMA, DSA, KI-Verordnung) durchzusetzen und die Plattformen zu zwingen, gegen illegale Inhalte vorzugehen",
          "seite": 50
        }
      ],
      "neue_buendel": [
        {
          "ursache": 4301,
          "name": "KI-Einsatz vorantreiben",
          "seite": 38
        }
      ],
      "nicht_erfasst": [
        {
          "ursache": 4302,
          "seiten": [
            13,
            14,
            15,
            38
          ],
          "grund": "Weiterbildung und Qualifizierung nur allgemein (Recht auf Weiterbildung, Weiterbildungsförderung der BA, Lebenslanges Lernen im öffentlichen Dienst); keine Zusage mit KI-Bezug zum Kompetenzaufbau der Beschäftigten."
        }
      ]
    },
    {
      "partei_id": 13,
      "land": null,
      "massnahmen": [
        {
          "beschreibung": "KI-Entwicklung und -Anwendung gezielt fördern und digitale Kompetenzen in Unternehmen und Hochschulen stärken.",
          "ursachen_ids": [
            4301
          ],
          "ursachen_offen": [
            4302
          ],
          "buendel": "KI-Einsatz vorantreiben, neue KI-Berufe schaffen",
          "zitat": "Wir haben eine große Kompetenz in Künstlicher Intelligenz (KI), müssen diese aber stärker in die Praxis bringen. Dazu wollen wir die Entwicklung und Anwendung von KI, die Etablierung robuster Cybersicherheitsstandards sowie die Stärkung digitaler Kompetenzen in Unternehmen und Hochschulen – etwa durch eine Weiterentwicklung der Mittelstandsdigitalzentren – gezielt fördern",
          "seite": 23
        },
        {
          "beschreibung": "Verbreitung von Nacktbildern gegen den Willen Betroffener, auch KI-generierter, grundsätzlich strafbar machen.",
          "ursachen_ids": [
            4303
          ],
          "buendel": "Strafbarkeit von Deepfakes",
          "zitat": "Bei der Umsetzung der EU-Richtlinie zur Bekämpfung von Gewalt gegen Frauen setzen wir uns dafür ein, dass die Verbreitung von KI-generierten oder echten Nacktbildern gegen den Willen der Betroffenen grundsätzlich eine Straftat darstellt.",
          "seite": 119
        }
      ]
    },
    {
      "partei_id": 14,
      "land": null,
      "massnahmen": [
        {
          "beschreibung": "Chancen von KI in der Justiz ausloten, ohne dass KI richterliche Entscheidungen ersetzt",
          "ursachen_ids": [],
          "ursachen_offen": [
            4301
          ],
          "buendel": "Schutz vor KI-Verdrängung",
          "zitat": "Dazu gehört auch, dass die Chancen der Künstlichen Intelligenz (KI) in der Justiz genutzt werden. Diese wollen wir konsequent ausloten, ohne dass KI richterliche Entscheidungen ersetzt.",
          "seite": 23
        },
        {
          "beschreibung": "KI-Bürgerassistenten einführen, der Bürgerinnen und Bürger bei digitalen Behördengängen unterstützt",
          "ursachen_ids": [],
          "ursachen_offen": [
            4301
          ],
          "buendel": "KI-Einsatz vorantreiben, neue KI-Berufe schaffen",
          "zitat": "Außerdem wollen wir einen KI-Bürgerassistenten einführen, der Bürgerinnen und Bürger bei digitalen Behördengängen unterstützt.",
          "seite": 39
        },
        {
          "beschreibung": "Lehramtsstudium mit stärkerem Fokus auf KI-Kompetenzen ausrichten",
          "ursachen_ids": [],
          "ursachen_offen": [
            4302
          ],
          "zitat": "Die Lehrausbildung wollen wir bundesweit zu einem dualen Lehramtsstudium weiterentwickeln, das Theorie und Praxis eng miteinander verzahnt und einen stärkeren Fokus auf digitale und KI-Kompetenzen legt.",
          "seite": 9
        }
      ],
      "nicht_erfasst": [
        {
          "ursache": 4303,
          "seiten": [
            24,
            27,
            49
          ],
          "grund": "Cyberabwehr, Sorgfaltspflichten für Plattformen (DSA) und Abwehr chinesischer Angriffe ohne KI-Bezug; keine Regel zu KI-Fälschungen, Deepfakes, Stimmklonen oder offenen Modellen."
        }
      ],
      "neue_buendel": [
        {
          "ursache": 4302,
          "name": "KI-Kompetenz in der Lehrkräfteausbildung",
          "seite": 9
        }
      ]
    },
    {
      "partei_id": 15,
      "land": null,
      "massnahmen": [
        {
          "beschreibung": "Gesetzliche Rahmenbedingungen schaffen, die den KI-Einsatz etwa in Medizintechnik und Verkehrswesen ermöglichen",
          "ursachen_ids": [],
          "ursachen_offen": [
            4301
          ],
          "buendel": "KI-Einsatz vorantreiben, neue KI-Berufe schaffen",
          "zitat": "KI-Systeme stellen einen großen Wachstumsmarkt dar; von diesen können und wollen wir uns in Deutschland nicht abkoppeln. Deshalb sind effektive gesetzliche Rahmenbedingungen notwendig, die den Einsatz zum Beispiel in Medizintechnik und Verkehrswesen ermöglichen.",
          "seite": 51
        },
        {
          "beschreibung": "EU-Regulierung von KI ablehnen und praxisnahe nationale Lösungen gegen KI-Risiken fordern",
          "ursachen_ids": [],
          "ursachen_offen": [
            4303
          ],
          "buendel": "Gegenrichtung: Forschung und offene Modelle erlauben",
          "zitat": "Gleichzeitig kann KI aber auch ein Risiko speziell für Kritische Infrastruktur, Verkehrstechnik und bürgerliche Freiheiten darstellen. Die zentralistische Regulierung dieser Themen durch die EU, wie durch den Cybersecurity Act, Ethik-Leitlinien für KI und den Artificial Intelligence Act, lehnt die AfD ab und fordert praxisnahe, nationale Lösungen.",
          "seite": 51
        }
      ],
      "nicht_erfasst": [
        {
          "ursache": 4302,
          "seiten": [
            24,
            160,
            163
          ],
          "grund": "Weiterbildung im Bürgergeld (S. 24) und berufliche Bildung (S. 163) ohne KI-Bezug; KI-Umgang in Schulen (S. 160) gehört zur Schulbildung (Ursache 4), nicht zu 2."
        },
        {
          "ursache": 4303,
          "seiten": [
            47,
            48
          ],
          "grund": "Digitale Assistenzsysteme und Überwachung (S. 47–48) ohne KI-Bezug zu Betrug oder Täuschung."
        }
      ],
      "eigene_synonyme": [
        {
          "begriff": "künstliche intelligenz",
          "ursache": 4301,
          "richtung": "KI-Einsatz vorantreiben, neue KI-Berufe schaffen"
        }
      ]
    },
    {
      "partei_id": 16,
      "land": null,
      "massnahmen": [
        {
          "beschreibung": "Lernsoftware nicht als Ersatz für Lehrpersonal einsetzen; KI nicht zur Bewertung von Lernerfolgen nutzen",
          "ursachen_ids": [
            4301
          ],
          "buendel": "Schutz vor KI-Verdrängung",
          "zitat": "Lernsoftware darf nicht als Ersatz für Lehrpersonal eingesetzt werden. KI darf nicht für die Bewertung oder die Vorhersage von Lernerfolgen genutzt werden.",
          "seite": 39
        },
        {
          "beschreibung": "KI-Wissen als Teil der beruflichen Ausbildung verankern",
          "ursachen_ids": [
            4302
          ],
          "zitat": "Politische Bildung, Medienkompetenz und KI-Wissen sollen Teil der beruflichen Ausbildung sein.",
          "seite": 40
        },
        {
          "beschreibung": "KI-erzeugte Medieninhalte kennzeichnen; Plattformen haften für Falschinformationen und Rechtsverstöße solcher Inhalte",
          "ursachen_ids": [
            4303
          ],
          "buendel": "Löschpflicht und Plattformhaftung für KI-Fälschungen",
          "zitat": "Durch Künstliche Intelligenz erzeugte Medieninhalte müssen gekennzeichnet werden, Plattformen haften bei Falschinformationen und Rechtsverstößen durch solche Inhalte.",
          "seite": 55
        },
        {
          "beschreibung": "Kriminalpolizei und Staatsanwaltschaft so ausstatten, dass sie KI-gestützte Manipulation verfolgen können",
          "ursachen_ids": [],
          "ursachen_offen": [
            4303
          ],
          "zitat": "Stattdessen müssen Kriminalpolizei und Staatsanwaltschaft in die Lage versetzt werden, mit der dynamischen Entwicklung von Kriminalität Schritt zu halten: von der Wirtschaftskriminalität über Cyber-Attacken hin zu Manipulation mithilfe von KI und Algorithmen in sozialen Medien.",
          "seite": 48
        },
        {
          "beschreibung": "EU-Gesetze zu KI und digitalen Diensten zügig in nationales Recht überführen",
          "ursachen_ids": [],
          "ursachen_offen": [
            4303
          ],
          "zitat": "Die EU-Gesetze über Künstliche Intelligenz (AI Act) und über digitale Dienste (Digital Services Act) müssen zügig in nationales Recht überführt und perspektivisch weiterentwickelt werden.",
          "seite": 57
        }
      ],
      "nicht_erfasst": [
        {
          "ursache": 4301,
          "seiten": [
            28,
            57,
            58
          ],
          "grund": "Kapitel 7 (S. 28) und Kap. 20 (S. 57–58) gelesen: Weiterbildungs- und Absicherungsmaßnahmen ohne KI-Bezug; Ziel einer gerechten Verteilung der Gewinne aus Automatisierung und KI (S. 58) ist kein Hebel gegen Verdrängung, nicht aufgenommen."
        }
      ],
      "neue_buendel": [
        {
