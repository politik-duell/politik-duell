{
  "blind_pruefsumme": "6eb993f78e35ecf0b33ca93c2c07fd83faebbadb5bf0355c432bfb87c3ee040e",
  "neue_instrumente": [
    {
      "kennung": "I1",
      "name": "Begrünungspflicht bzw. Mindestgrünanteil für Neubauten (Dach, Fassade, Freifläche) (Land)",
      "wirksamkeit": 2,
      "umsetzbarkeit": 3,
      "begruendung": "Per Bauordnung umsetzbar; Gründächer und -fassaden senken Oberflächentemperaturen um rund 2 °C. Dagegen: Wirkung auf die Lufttemperatur auf Straßenniveau ist gering belegt und betrifft nur Neubauten, also langsam.",
      "evidenz": "gemischt",
      "beleg_studie_url": "https://research.bangor.ac.uk/en/publications/how-effective-is-greening-of-urban-areas-in-reducing-human-exposu/"
    },
    {
      "kennung": "I2",
      "name": "Straßenbäume in großer Zahl neu pflanzen (Land)",
      "wirksamkeit": 2,
      "umsetzbarkeit": 2,
      "begruendung": "Bäume kühlen nachweislich durch Schatten und Verdunstung (Studien: spürbar niedrigere Temperaturen bei mehr Baumbestand). Dagegen: Wirkung wächst erst über Jahre, Pflanzung und Bewässerung brauchen dauerhaft Geld und Personal.",
      "evidenz": "belegt",
      "beleg_studie_url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC6458494/"
    },
    {
      "kennung": "I3",
      "name": "Bestand an Stadtbäumen und Grünflächen schützen, bewässern und pflegen (Land)",
      "wirksamkeit": 1,
      "umsetzbarkeit": 3,
      "begruendung": "Erhält die belegte Kühlwirkung von Bäumen und Grün und ist mit Haushaltsmitteln und Verordnungen umsetzbar. Dagegen: sichert vor allem den Bestand und schafft kaum zusätzliche Kühlung.",
      "evidenz": "belegt",
      "beleg_studie_url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC6458494/"
    },
    {
      "kennung": "I4",
      "name": "Neue Grünflächen, Stadtwald und hitzeangepasste Quartiere schaffen und fördern (Land)",
      "wirksamkeit": 2,
      "umsetzbarkeit": 2,
      "begruendung": "Parks und Stadtwälder kühlen ihr Umfeld nachweislich (große Parks 1 bis 2 °C, Reichweite mehrere hundert Meter). Dagegen: Flächen in dichten Städten sind knapp, Umsetzung dauert Jahre und Wirkung bleibt lokal.",
      "evidenz": "belegt",
      "beleg_studie_url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC6458494/"
    },
    {
      "kennung": "I5",
      "name": "Allgemeine Zusage zu Klimaanpassung, Stadtgrün oder Starkregenvorsorge ohne konkretes Instrument (Land)",
      "wirksamkeit": 1,
      "umsetzbarkeit": 2,
      "begruendung": "Grün, Verschattung und Wasserrückhalt wirken nachweislich; die Zusage nennt aber weder Instrument noch Umfang oder Mittel, daher ist kaum eine Verbesserung absehbar.",
      "evidenz": "belegt",
      "beleg_studie_url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC6458494/"
    },
    {
      "kennung": "I6",
      "name": "Kaltluftschneisen und große Freiflächen in der Stadt von Bebauung freihalten (Land)",
      "wirksamkeit": 2,
      "umsetzbarkeit": 3,
      "begruendung": "Kaltluft aus Freiflächen entlastet überhitzte Stadtteile in heißen Nächten, Fachrichtlinien empfehlen den Erhalt von Luftleitbahnen; planerisch umsetzbar. Dagegen: wirkt nur bei windschwachen Nächten und in begrenzter Reichweite.",
      "evidenz": "belegt",
      "beleg_studie_url": "https://www.baulinks.de/webplugin/2024/0925.php4"
    },
    {
      "kennung": "I7",
      "name": "Baulichen Hitzeschutz an Schulen, öffentlichen Gebäuden und Einrichtungen fördern und umsetzen (Land)",
      "wirksamkeit": 2,
      "umsetzbarkeit": 2,
      "begruendung": "Verschattung, Nachtlüftung und passive Kühlung senken Innentemperaturen in Modellstudien deutlich. Dagegen: Nachrüstung ist teuer und dauert, bei künftig stärkerer Hitze reichen passive Maßnahmen allein teils nicht.",
      "evidenz": "gemischt",
      "beleg_studie_url": "https://www.cibsejournal.com/cibse-news/study-tests-overheating-strategies-in-care-homes/"
    },
    {
      "kennung": "I8",
      "name": "Hitzeschutzpläne und -konzepte für gefährdete Gruppen und Einrichtungen umsetzen (Land)",
      "wirksamkeit": 2,
      "umsetzbarkeit": 3,
      "begruendung": "Hitzeschutzpläne gingen in 14 europäischen Ländern mit rund 25 % weniger hitzebedingten Todesfällen einher; Länder können sie mit geringem Aufwand ausbauen. Dagegen: kühlen die Stadt nicht, Wirkung hängt von verbindlicher Umsetzung ab.",
      "evidenz": "belegt",
      "beleg_studie_url": "https://www.santepubliquefrance.fr/en/node/37874"
    },
    {
      "kennung": "I9",
      "name": "Trinkbrunnen und Trinkwasserspender im öffentlichen Raum ausbauen (Land)",
      "wirksamkeit": 1,
      "umsetzbarkeit": 3,
      "begruendung": "Kostengünstig und schnell umsetzbar, erleichtert ausreichendes Trinken bei Hitze. Dagegen: lindert nur Folgen, eine gesundheitliche Wirkung öffentlicher Trinkbrunnen ist kaum untersucht.",
      "evidenz": "offen"
    },
    {
      "kennung": "I10",
      "name": "Öffentliche Abkühlungsmöglichkeiten schaffen: Badestellen, Planschen und Brunnen (Land)",
      "wirksamkeit": 1,
      "umsetzbarkeit": 2,
      "begruendung": "Bietet Abkühlung an heißen Tagen, besonders ohne Freibad in der Nähe. Dagegen: lindert nur Folgen, Wasserqualität und Badesicherheit erfordern Aufwand; Wirkung auf Gesundheit kaum untersucht.",
      "evidenz": "offen"
    },
    {
      "kennung": "I11",
      "name": "Spielplätze und öffentliche Wasserflächen mit Sonnensegeln verschatten (Land)",
      "wirksamkeit": 1,
      "umsetzbarkeit": 3,
      "begruendung": "Schatten senkt die gefühlte Temperatur vor Ort deutlich und ist günstig umsetzbar. Dagegen: wirkt nur punktuell an einzelnen Orten, Gesundheitswirkung kaum gesondert untersucht.",
      "evidenz": "offen"
    },
    {
      "kennung": "I12",
      "name": "Verbindliches Netto-Null-Ziel oder Flächenkontingente für Neuversiegelung festlegen (Land)",
      "wirksamkeit": 2,
      "umsetzbarkeit": 2,
      "begruendung": "Verbindliche Kontingente erreichten im UBA-Modellversuch mit 87 Kommunen die Flächensparziele. Dagegen: bisher nur simuliert; nicht verbindliche Landesziele wurden meist verfehlt, Umsetzung braucht Landesplanung und Jahre.",
      "evidenz": "gemischt",
      "beleg_studie_url": "https://www.umweltbundesamt.de/en/publikationen/modellversuch-flaechenzertifikatehandel"
    },
    {
      "kennung": "I13",
      "name": "Vorrang für Innenentwicklung, Flächenrecycling und Freiflächenschutz ohne verbindliche Mengenvorgabe (Land)",
      "wirksamkeit": 1,
      "umsetzbarkeit": 3,
      "begruendung": "Brachen und Innenentwicklung bieten großes Flächenpotenzial und sind planerisch umsetzbar. Dagegen: Der Vorrang gilt schon im Baurecht, ohne verbindliche Ziele wurde der Flächenverbrauch kaum gebremst; Brachen sind oft teuer zu mobilisieren.",
      "evidenz": "gemischt",
      "beleg_studie_url": "https://www.umweltbundesamt.de/themen/boden-landwirtschaft/flaechensparen-boeden-landschaften-erhalten/flaechenrecycling-innenentwicklung"
    },
    {
      "kennung": "I14",
      "name": "Entsiegelung öffentlicher und privater Flächen fördern oder vorschreiben (Land)",
      "wirksamkeit": 2,
      "umsetzbarkeit": 3,
      "begruendung": "Unversiegelte und durchlässige Flächen verringern den Regenabfluss nachweislich und können begrünt werden; Förderung ist Landessache. Dagegen: entsiegelbare Flächen sind begrenzt, Wirkung bleibt lokal.",
      "evidenz": "belegt",
      "beleg_studie_url": "https://iieta.org/journals/ijsdp/paper/10.2495/SDP-V10-N6-806-817"
    },
    {
      "kennung": "I15",
      "name": "Schwammstadt: dezentrale Regenwasserbewirtschaftung, Abkopplung und Rückhalt in Siedlungen ausbauen (Land)",
      "wirksamkeit": 2,
      "umsetzbarkeit": 2,
      "begruendung": "Versickerung, Rückhalt und Abkopplung verringern den Abfluss nachweislich und entlasten die Kanalisation bei Starkregen. Dagegen: Umbau des Bestands ist teuer und langwierig, bei extremem Starkregen bleibt die Wirkung begrenzt.",
      "evidenz": "belegt",
      "beleg_studie_url": "https://iieta.org/journals/ijsdp/paper/10.2495/SDP-V10-N6-806-817"
    },
    {
      "kennung": "I16",
      "name": "Landesberatungsstelle für Regenwasserbewirtschaftung besser ausstatten (Land)",
      "wirksamkeit": 1,
      "umsetzbarkeit": 3,
      "begruendung": "Beratung und Koordination können den Umbau zur Schwammstadt beschleunigen und sind günstig umsetzbar. Dagegen: Die Stelle baut selbst kaum etwas, ihr eigener Beitrag zur Entsiegelung ist nicht untersucht.",
      "evidenz": "offen"
    },
    {
      "kennung": "I17",
      "name": "Regenwassernutzung vorschreiben oder erleichtern (Bauordnung, Bewässerung, Regentonnen) (Land)",
      "wirksamkeit": 1,
      "umsetzbarkeit": 3,
      "begruendung": "Per Bauordnung oder Vorgabe leicht umsetzbar, hält etwas Regenwasser vor Ort. Dagegen: Speichervolumen ist klein, bei Starkregen ist der Speicher schnell voll; Wirkung kaum untersucht.",
      "evidenz": "offen"
    },
    {
      "kennung": "I18",
      "name": "Kein neues Baurecht für Bürogebäude, um Versiegelung zu vermeiden (Land)",
      "wirksamkeit": 1,
      "umsetzbarkeit": 2,
      "begruendung": "Verhindert einzelne Neuversiegelungen. Dagegen: Bürobauten sind ein kleiner Teil der Neuversiegelung, bestehendes Baurecht bleibt; die Wirkung ist nicht untersucht.",
      "evidenz": "offen"
    },
    {
      "kennung": "I19",
      "name": "Retentionsräume, Auen und Deichrückverlegungen für den Hochwasserschutz schaffen oder sichern (Land)",
      "wirksamkeit": 2,
      "umsetzbarkeit": 2,
      "begruendung": "Auen und Rückhalteflächen dämpfen Hochwasserscheitel nachweislich. Dagegen: Flächenerwerb und Planung dauern viele Jahre, und die Bebauung in Überschwemmungsgebieten ändert sich dadurch nicht.",
      "evidenz": "belegt",
      "beleg_studie_url": "https://www.umweltbundesamt.de/hochwasser-durch-renaturierung-entschaerfen"
    },
    {
      "kennung": "I20",
      "name": "Deiche, Dünen und Hochwasserschutzanlagen sanieren und modernisieren (Land)",
      "wirksamkeit": 2,
      "umsetzbarkeit": 3,
      "begruendung": "Technischer Hochwasserschutz schützt bebaute Gebiete wirksam und wird von Ländern mit Bundesmitteln bereits betrieben. Dagegen: Deiche können Risiken flussabwärts verlagern und ändern das Bauen in Überschwemmungsgebieten nicht.",
      "evidenz": "belegt",
      "beleg_studie_url": "https://www.umweltbundesamt.de/hochwasser-durch-renaturierung-entschaerfen"
    },
    {
      "kennung": "I21",
      "name": "Keine neuen Baugebiete und Bebauung in Überschwemmungsgebieten zulassen (Land)",
      "wirksamkeit": 3,
      "umsetzbarkeit": 2,
      "begruendung": "Verzicht auf Bebauung in Überschwemmungsflächen gilt Fachbehörden als wirksamste Vermeidung von Hochwasserschäden. Dagegen: Rahmen setzt das Bundesrecht (Ausnahmen im WHG), Länder können nur Planung und Ausnahmepraxis verschärfen; Bestand bleibt.",
      "evidenz": "belegt",
      "beleg_studie_url": "https://www.lfu.bayern.de/wasser/hw_handlungsfelder/vermeidung/index.htm"
    }
  ],
