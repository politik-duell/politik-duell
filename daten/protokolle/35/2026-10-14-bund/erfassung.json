{
  "thema_id": 35,
  "programme": [
    {
      "partei_id": 11,
      "land": null,
      "massnahmen": [
        {
          "beschreibung": "Bürokratie abbauen und die Ausbildung effizient gestalten, damit der Führerschein für junge Menschen bezahlbar bleibt.",
          "ursachen_ids": [
            3501
          ],
          "ursachen_offen": [
            3502
          ],
          "zitat": "Der Führerschein muss für junge Menschen bezahlbar sein. Dafür gilt es, Bürokratie abzubauen und die Ausbildung effizient zu gestalten.",
          "seite": 74
        }
      ]
    },
    {
      "partei_id": 12,
      "land": null,
      "massnahmen": [
        {
          "beschreibung": "Fahrausbildung samt Theorieunterricht reformieren, auch mit dem Ziel, die Kosten der Fahrausbildung spürbar zu senken",
          "ursachen_ids": [
            3501,
            3502
          ],
          "zitat": "Vor dem Hintergrund erhöhter Quoten nicht bestandener Prüfungen und steigender Preise werden wir die Fahrausbildung samt Theorieunterricht im Sinne von Verkehrssicherheit und Effizienz reformieren, auch mit dem Ziel, die Kosten der Fahrausbildung spürbar zu senken.",
          "seite": 36
        },
        {
          "beschreibung": "Alle Jugendlichen im 17. Lebensjahr erhalten 500 Euro Guthaben, unter anderem für Führerscheinkosten",
          "ursachen_ids": [
            3501
          ],
          "zitat": "Alle jungen Menschen im 17. Lebensjahr sollen daher einen MobilitätsPass mit 500 Euro Guthaben, etwa für Führerscheinkosten, Bahntickets oder Fahrräder, erhalten.",
          "seite": 36
        },
        {
          "beschreibung": "Arbeitgeber sollen einen steuer- und abgabenfreien Führerscheinzuschuss bis 2.000 Euro an Auszubildende und junge Beschäftigte zahlen können",
          "ursachen_ids": [
            3501
          ],
          "zitat": "Zudem wollen wir Arbeitgebern ermöglichen, einen Führerscheinzuschuss von bis zu 2.000 Euro steuer- und abgabenfrei an Auszubildende und junge Beschäftigte auszuzahlen.",
          "seite": 36
        }
      ]
    },
    {
      "partei_id": 13,
      "land": null,
      "massnahmen": [
        {
          "beschreibung": "Förderung des Führerscheinerwerbs für Menschen in Ausbildung",
          "ursachen_ids": [
            3501
          ],
          "zitat": "Wir wollen für Menschen in Ausbildung auch den Führerscheinerwerb fördern […]",
          "seite": 78
        }
      ],
      "nicht_erfasst": [
        {
          "ursache": 3502,
          "seiten": [
            20,
            48,
            78
          ],
          "grund": "Keine Aussage zu Ausbildungsumfang, Pflichtstunden, Prüfungen oder Wiederholungen. S. 48 nennt Verkehrssicherheit nur als allgemeines Ziel, S. 20 und 78 ohne Bezug zur Fahrerlaubnis."
        }
      ]
    },
    {
      "partei_id": 14,
      "land": null,
      "massnahmen": [
        {
          "beschreibung": "Führerschein sowie Lkw- und Bus-Qualifikation günstiger machen: Obergrenze für Theorieunterricht entfällt, Theorie digital, Fahrsimulatoren in der Ausbildung.",
          "ursachen_ids": [
            3501
          ],
          "ursachen_offen": [
            3502
          ],
          "zitat": "Deshalb wollen wir den Führerschein und die Berufskraftfahrerqualifikation (Lkw-Führerschein, Bus-Führerschein) wieder günstiger machen, z. B. durch den Verzicht auf eine Tagesobergrenze für den Theorieunterricht, die Möglichkeit den Theorieunterricht digital zu absolvieren und die Integration von Fahrsimulatoren in der Ausbildung.",
          "seite": 42
        },
        {
          "beschreibung": "Prüfungsmarkt für weitere Anbieter öffnen, Fahrprüfer ohne Ingenieursstudium weiterbilden, mehr Prüftermine und kürzere Wartezeiten.",
          "ursachen_ids": [
            3502
          ],
          "ursachen_offen": [
            3501
          ],
          "zitat": "Mit der Öffnung des Prüfungsmarktes für weitere Anbieter und einer Weiterbildung zum Fahrprüfer auch ohne Ingenieursstudium wollen wir die Anzahl an Prüfterminen steigern und Wartezeiten deutlich senken.",
          "seite": 42
        },
        {
          "beschreibung": "Begleitetes Fahren ab 16 Jahren ermöglichen.",
          "ursachen_ids": [
            3502
          ],
          "zitat": "Das begleitete Fahren wollen wir ab 16 Jahren ermöglichen – denn frühe Fahrpraxis erhöht nachweislich die Verkehrssicherheit.",
          "seite": 42
        },
        {
          "beschreibung": "Zwangstests für Senioren ablehnen.",
          "ursachen_ids": [
            3502
          ],
          "zitat": "Diskriminierende Zwangstests für Senioren lehnen wir ab.",
          "seite": 42
        }
      ],
      "neue_buendel": [
        {
          "ursache": 3502,
          "name": "Begleitetes Fahren ab 16",
          "seite": 42
        },
        {
          "ursache": 3502,
          "name": "Keine Zwangstests für Senioren",
          "seite": 42
        }
      ]
    },
