      "massnahmen": [
        {
          "beschreibung": "Gesetzliche Zielgrößen für den Betreuungsschlüssel in Krippe und Kita",
          "ursachen_ids": [
            1703
          ],
          "zitat": "Wir verankern daher gesetzliche Zielgrößen für den Betreuungsschlüssel von 1:3 in der Krippe und 1:7,5 in der Kita.",
          "seite": 44
        },
        {
          "beschreibung": "Ausbildung und Qualifizierungswege ausbauen, Quereinstieg besser strukturieren, ausländische Abschlüsse schneller anerkennen",
          "ursachen_ids": [
            1702
          ],
          "zitat": "Wir bauen Ausbildung und Qualifizierungswege aus, strukturieren den Quereinstieg besser und beschleunigen die Anerkennung ausländischer Abschlüsse.",
          "seite": 44
        },
        {
          "beschreibung": "Multiprofessionelle Teams in Kitas stärken, um Fachkräfte zu entlasten",
          "ursachen_ids": [
            1702
          ],
          "zitat": "Wir stärken multiprofessionelle Teams in den Kitas: Neben Erzieher*innen arbeiten dort Fachkräfte aus den Bereichen Gesundheit, Sozial- und Heilpädagogik zusammen.",
          "seite": 44
        },
        {
          "beschreibung": "Vorrang beim Kita-Platzausbau für Quartiere mit hohem Bedarf",
          "ursachen_ids": [
            1701
          ],
          "zitat": "Kitas in Quartieren mit hohem Bedarf erhalten Vorrang beim Platzausbau.",
          "seite": 45
        },
        {
          "beschreibung": "Flexiblere Öffnungszeiten für Eltern mit Schicht- oder unregelmäßiger Arbeit",
          "ursachen_ids": [
            1704
          ],
          "zitat": "Wir gestalten Öffnungszeiten flexibler, damit auch Eltern mit Schichtarbeit oder unregelmäßigen Arbeitszeiten verlässliche Betreuung finden.",
          "seite": 45
        }
      ],
      "nicht_erfasst": [
        {
          "ursache": 1705,
          "seiten": [
            44,
            45
          ],
          "grund": "Kapitel Kita (S. 44-45) gelesen; keine Aussage zu Elternbeiträgen. Beitragsfreie Vorschule nur als Best Practice Frankreich."
        }
      ]
    },
    {
      "partei_id": 18,
      "land": "MV",
      "massnahmen": [
        {
          "beschreibung": "Beitragsfreiheit der Kitas langfristig absichern, unabhängig vom Einkommen der Eltern.",
          "ursachen_ids": [
            1705
          ],
          "zitat": "Kostenlose Kitas dauerhaft sichern Langfristige Absicherung der Beitragsfreiheit, Gewährleistung frühkindlicher Bildung als Teil der öffentlichen Daseinsvorsorge, unabhängig vom Einkommen der Eltern.",
          "seite": 9
        },
        {
          "beschreibung": "Besserer Betreuungsschlüssel mit mehr pädagogischem Personal pro Gruppe sowie bessere Arbeitsbedingungen und angemessene Vergütung.",
          "ursachen_ids": [
            1702,
            1703
          ],
          "zitat": "Besserer Betreuungsschlüssel und bessere Bezahlung Die Verbesserung der Arbeitsbedingungen, die Erhöhung der Qualität der Betreuung und mehr pädagogisches Personal pro Gruppe sowie eine angemessene Vergütung machen den Beruf langfristig attraktiv.",
          "seite": 9
        }
      ],
      "nicht_erfasst": [
        {
          "ursache": 1704,
          "seiten": [
            8,
            9,
            12
          ],
          "grund": "Treffer zu 'verlässlich' betreffen digitale Infrastruktur, Schulbetrieb, Mobilität; nichts zu ungeplanten Kita-Schließungen. Ganztagsschule erhalten (S. 9) ist Schulbetreuung, keine Kita-Zusage."
        },
        {
          "ursache": 1701,
          "seiten": [
            5,
            9,
            10
          ],
          "grund": "Keine Zusage zum Ausbau von Kita-Plätzen; Kita-Treffer betreffen Kostenfreiheit, Qualität, Sprachförderung."
        }
      ]
    },
    {
