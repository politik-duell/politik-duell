        {
          "beschreibung": "Sechs Stunden tägliche Kita-Betreuung landesweit kostenfrei; darüber hinaus Beiträge nach Elterneinkommen gestaffelt.",
          "ursachen_ids": [
            1705
          ],
          "zitat": "6 Stunden tägliche Kita-Betreuung als landesweit kostenfreie Grundversorgung für alle Kinder ab dem ersten Lebensjahr bis zur Einschulung sichern",
          "seite": 14
        }
